# ============================================================================
# LiteLLM Gateway secrets — copy to `.env` and replace every value below.
#   cp .env.example .env
# `.env` is gitignored. NEVER commit real secrets.
# ============================================================================

# Admin master key. Used to log into the Admin UI and to provision team keys.
# Must start with "sk-". Generate a strong one, e.g.:  openssl rand -hex 32
LITELLM_MASTER_KEY=sk-master-CHANGE-THIS-TO-A-LONG-RANDOM-SECRET

# Encrypts stored credentials in Postgres. Set ONCE before first start and
# NEVER change it afterward (changing it makes existing stored keys unreadable).
LITELLM_SALT_KEY=sk-salt-CHANGE-THIS-ONCE-AND-KEEP-SAFE

# Postgres password. This value MUST be identical to the password embedded in
# DATABASE_URL below, or LiteLLM cannot connect to its own database.
POSTGRES_PASSWORD=litellm_pass

# Connection string LiteLLM uses to reach the Postgres container.
# Host is the compose service name `litellm-db`. Keep the password in sync
# with POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://litellm:litellm_pass@litellm-db:5432/litellm

# --- Dashboard (custom admin UI on :8080) ---
# HTTP Basic credentials to open the dashboard. Pick a strong password.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CHANGE-THIS-DASHBOARD-PASSWORD
